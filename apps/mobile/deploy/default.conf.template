server {
    listen 8080;
    root /usr/share/nginx/html;
    server_tokens off;

    # File names don't change between versions: browsers revalidate every
    # file (cheap with ETags) and the service worker keeps the app offline.
    add_header Cache-Control "no-cache" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ${API_ORIGIN} ${PHOTOS_ORIGIN}; img-src 'self' blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    gzip on;
    gzip_types application/javascript application/wasm application/json application/manifest+json text/css text/plain font/ttf font/otf;

    location = /health {
        access_log off;
        return 200 "ok\n";
    }

    location ~ /\.well-known/ {
        return 404;
    }

    # nginx's MIME list has no .mjs, which browsers refuse to run as a
    # module unless it is served as JavaScript.
    location ~ \.mjs$ {
        types { }
        default_type application/javascript;
    }

    location / {
        try_files $uri /index.html;
    }
}
